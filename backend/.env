# ---- WhatsApp Sending Mode ----
# "cloud_api" = real bulk send using Meta WhatsApp Business Cloud API (needs approval + key below)
# "wa_link"    = no key needed, frontend opens wa.me links per patient (manual click per number, good for testing)
WHATSAPP_MODE=baileys
# ---- Meta WhatsApp Cloud API (only needed when WHATSAPP_MODE=cloud_api) ----
# Get these after creating a Meta App + WhatsApp Business product:
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Message template name approved in Meta Business Manager (required for Cloud API
# to message numbers that have not messaged you in the last 24 hours, which is the
# normal case for a camp announcement blast). Create this template first in
# Meta Business Manager > WhatsApp Manager > Message Templates.
WHATSAPP_TEMPLATE_NAME=camp_announcement
WHATSAPP_TEMPLATE_LANG=en
